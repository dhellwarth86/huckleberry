# Copy to .env (which is gitignored) and fill in real values.
# See PHASE_2_HANDOFF.md Section 2.1 for provider-specific setup.

# ── Object storage (S3-compatible) ──────────────────────────────
# Provider choices: cloudflare-r2 | minio | backblaze-b2 | aws-s3
S3_PROVIDER=cloudflare-r2
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=huckleberry-fixtures
S3_ACCESS_KEY_ID=<your_access_key>
S3_SECRET_ACCESS_KEY=<your_secret_key>
S3_REGION=auto

# ── PostgreSQL ──────────────────────────────────────────────────
# Default connection points at the docker-compose Postgres service.
DATABASE_URL=postgresql+asyncpg://huckleberry:huckleberry@localhost:5432/huckleberry

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
