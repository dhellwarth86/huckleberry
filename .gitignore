# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.uv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
package-lock.json

# Env / secrets — never commit credentials
.env
*.env.local
*.env.production

# Docker volumes
postgres-data/
minio-data/

# Editor
.vscode/
.idea/
*.swp
*.swo
.cursor/

# OS
.DS_Store
Thumbs.db

# Experiment outputs are committed as the v0.1 deliverable for review.
# They are large but the bidset PDFs aren't in the repo, so re-running the
# experiment requires the original local bidset folder — committing the
# artifacts is the audit trail. Tmp files stay excluded.
backend/test_fixtures/experiment_outputs/*.tmp

# Experiment run logs are runtime artifacts, not deliverables.
backend/experiment_run.log
backend/test_fixtures/bidsets.json.tmp

# v0.2 dispatch sweep log — runtime artifact, not deliverable.
backend/scripts/v0.2_sweep.log

# v0.2 dispatch outputs are committed; tmp files stay excluded.
backend/test_fixtures/v0.2_outputs/*.tmp

# tracepoint_port/ — read-only reference material (mirror of C:/TracePoint/)
# placed in the working tree alongside v0.2 rubric briefs. NOT v0.2 work
# product. Excluded so v0.2's commit narrative stays focused on the port
# itself. Daniel can `git add -f tracepoint_port/` if reference material
# should be tracked in a separate commit.
tracepoint_port/

# Local PDF copies that shouldn't be in repo (real bidsets live in S3)
*.pdf
!**/test_fixtures/**/*.pdf  # if any tiny PDFs are intentionally version-controlled
